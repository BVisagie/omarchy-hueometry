# Builds Hueometry from this checkout into an Arch package (bin/install runs
# it). The QML, the compiled Bend engine and the sounds are inside the
# binary, so the package needs no Bend, Node or Python.
pkgname=hueometry
pkgver=0.2.1
pkgrel=1
pkgdesc='A colour-sorting puzzle for children and families, with a formally verified rules engine'
arch=('x86_64' 'aarch64')
url='https://github.com/BVisagie/omarchy-hueometry'
license=('MIT' 'CC-BY-SA-4.0' 'OFL-1.1')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'qt6-multimedia' 'qt6-svg')
makedepends=('gcc' 'make')
options=('!debug')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/app/hueometry "$pkgdir/usr/bin/hueometry"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 LICENSE-ASSETS "$pkgdir/usr/share/licenses/$pkgname/LICENSE-ASSETS"
  install -Dm644 LICENSE-OFL "$pkgdir/usr/share/licenses/$pkgname/LICENSE-OFL"
  install -Dm644 ASSETS.md "$pkgdir/usr/share/doc/$pkgname/ASSETS.md"
  install -Dm644 "$startdir/hueometry.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/hueometry.svg"
  install -Dm644 "$startdir/hueometry.desktop" "$pkgdir/usr/share/applications/hueometry.desktop"
}
