#!/usr/bin/env bash
# Runs everything CI runs. Usage: bin/check [base-ref] [head-ref]
set -euo pipefail
# shellcheck source=bin/env.sh
source "$(dirname "$0")/env.sh"
cd "$ROOT"
base="${1:-origin/main}"
head="${2:-HEAD}"

step() { printf '\n== %s\n' "$*"; }

step "shell scripts"
shellcheck -x -P SCRIPTDIR -P . bin/* tools/check/*.sh

step "laws are changed only with a Laws-Change trailer"
tools/check/laws-trailer.sh "$base" "$head"

step "proofs (bend PROOF.bend --verdict)"
bin/proof

step "engine.mjs matches the Bend sources"
bin/engine --check

step "no shipped file is over the marketplace scanner's 512 KiB"
big=$(find qml -type f -size +512k)
if [[ -n "$big" ]]; then
  echo "too big for the marketplace scan: $big" >&2
  exit 1
fi

step "engine tests (node)"
[[ -d node_modules ]] || npm ci --no-audit --no-fund
npm test --silent

step "native and JavaScript builds generate the same puzzles"
tools/check/native.sh

step "QML tests (Qt's JavaScript engine)"
QT_QPA_PLATFORM=offscreen QT_LOGGING_RULES="qt.qml.usedbeforedeclared=false" \
  /usr/lib/qt6/bin/qmltestrunner -input tests/qml

printf '\nAll checks passed.\n'
