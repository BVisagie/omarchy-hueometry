#!/usr/bin/env bash
# Builds and runs the C++ host's tests, without a screen.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
mkdir -p "$ROOT/build/test-host"
cd "$ROOT/build/test-host"
qmake6 "$ROOT/tests/host/host.pro" >/dev/null
make -s -j"$(nproc)"
QT_QPA_PLATFORM=offscreen ./tst_host
